{
  "observations": ["pv", "load", "soc", "tariff", "pmax", "pmin"],
  "agent_params": {
    "n_layers": 2,
    "hidden_size": 256,
    "actor_lr": 3e-4,
    "critic_lr": 3e-4,
    "alpha_lr": 3e-4,
    "batch_size": 256,
    "gamma": 0.99,
    "tau": 0.005,
    "init_alpha": 0.2,
    "target_entropy": -1,
    "replay_size": 1000000,
    "reward_scale": 1.0,
    "max_grad_norm": 10.0,
    "log_std_min": -20,
    "log_std_max": 2
  },
  "training": {
    "episodes": 500,
    "steps_per_episode": 288,
    "eval_freq": 10,
    "seed": 42,
    "device": "cuda"
  }
}
