{
  "seed": 42,
  "start_idx": 0,
  "max_updates": 1000,
  "checkpoint_freq": 10,
  "observations": [
    "pv", "load", "soc", "tariff",
    "peds_max", "peds_min", "pmax", "pmin",
    "hour_sin", "hour_cos",
    "day_sin", "day_cos",
    "month_sin", "month_cos",
    "weekday"
  ],
  "agent_params": {
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_epsilon": 0.2,
    "actor_lr": 0.0003,
    "critic_lr": 0.001,
    "entropy_coef": 0.01,
    "final_entropy_coef": 0.001,
    "lagrange_lambda": 1.0,
    "rollout_length": 864,
    "ppo_epochs": 3,
    "mini_batch_size": 96,
    "hidden_size": 128,
    "hidden_layers": 5,
    "lambda_ewc": 100.0,
    "early_stopping_patience": 200,
    "min_delta": 0.01
  },
  "log_dir": "logs",
  "model_dir": "models/ppo_ewc"
}
